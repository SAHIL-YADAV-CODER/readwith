<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#17212b">
    <title>SecureChat</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>">
</head>
<body>
    <!-- PIN Entry Screen -->
    <div id="pin-screen" class="screen active">
        <div class="pin-container">
            <div class="pin-logo">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="40" height="40">
                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>
                </svg>
            </div>
            <h1>SecureChat</h1>
            <p class="pin-subtitle">End-to-end encrypted messaging</p>
            <div class="pin-input-container">
                <input type="password" id="pin-input" maxlength="4" pattern="[0-9]*" inputmode="numeric" autocomplete="off" placeholder="••••">
            </div>
            <div class="pin-dots">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
            <button id="pin-submit" class="btn-primary">Unlock</button>
            <p id="pin-error" class="error-message"></p>
            <div class="chat-info-hint">
                To chat with someone, share this app link and give them the same PIN. Both users must enter the same PIN to see the encrypted messages.
            </div>
        </div>
    </div>

    <!-- Main Chat Screen - Telegram Style -->
    <div id="chat-screen" class="screen">
        <header class="chat-header">
            <button class="header-back" id="back-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
            </button>
            <div class="header-avatar" id="chat-avatar">SC</div>
            <div class="header-info">
                <h2 id="chat-name">Secure Chat</h2>
                <div class="header-status">
                    <span id="mode-indicator" class="status-online">encrypted</span>
                </div>
            </div>
            <div class="header-actions">
                <button id="settings-btn" class="icon-btn" title="Settings">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
                        <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                    </svg>
                </button>
                <button id="lock-btn" class="icon-btn" title="Lock">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                    </svg>
                </button>
            </div>
        </header>

        <div id="messages-container" class="messages-container">
            <div class="encryption-notice">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                    <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                </svg>
                <span>Messages are end-to-end encrypted</span>
            </div>
        </div>

        <div class="typing-indicator" id="typing-indicator">
            <div class="typing-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <span>Someone is typing...</span>
        </div>

        <!-- Media Preview -->
        <div class="media-preview" id="media-preview">
            <img src="" alt="" class="media-preview-thumb" id="preview-thumb">
            <div class="media-preview-info">
                <div class="media-preview-name" id="preview-name"></div>
                <div class="media-preview-size" id="preview-size"></div>
            </div>
            <button class="media-preview-cancel" id="preview-cancel">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                </svg>
            </button>
        </div>

        <div class="message-input-container">
            <!-- Attachment Menu -->
            <div class="attachment-menu" id="attachment-menu">
                <button class="attachment-option photo" data-type="image">
                    <div class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="24" height="24">
                            <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                        </svg>
                    </div>
                    <span>Photo</span>
                </button>
                <button class="attachment-option video" data-type="video">
                    <div class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="24" height="24">
                            <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>
                        </svg>
                    </div>
                    <span>Video</span>
                </button>
                <button class="attachment-option audio" data-type="audio">
                    <div class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="24" height="24">
                            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                        </svg>
                    </div>
                    <span>Audio</span>
                </button>
            </div>

            <div class="input-wrapper">
                <button class="attach-btn" id="attach-btn" title="Attach file">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                        <path d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/>
                    </svg>
                </button>
                <input type="text" id="message-input" placeholder="Message" autocomplete="off">
                <button id="send-btn" class="send-btn" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                    </svg>
                </button>
            </div>

            <!-- Hidden file inputs -->
            <input type="file" id="image-input" class="hidden-input" accept="image/*">
            <input type="file" id="video-input" class="hidden-input" accept="video/*">
            <input type="file" id="audio-input" class="hidden-input" accept="audio/*">
        </div>
    </div>

    <!-- Image Lightbox -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lightbox-close">&times;</button>
        <img src="" alt="" id="lightbox-image">
    </div>


    <!-- Settings Modal -->
    <div id="settings-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Settings</h2>
                <button id="close-settings" class="close-btn">&times;</button>
            </div>
            <div class="modal-body">
                <div class="setting-group">
                    <label>Your Display Name</label>
                    <input type="text" id="sender-id" placeholder="Enter your name" maxlength="20">
                    <p class="setting-hint">This name appears on your messages</p>
                </div>
                <div class="setting-group">
                    <label>Change PIN</label>
                    <div class="pin-change-form">
                        <input type="password" id="current-pin" placeholder="Current PIN" maxlength="4" inputmode="numeric">
                        <input type="password" id="new-pin" placeholder="New PIN" maxlength="4" inputmode="numeric">
                        <input type="password" id="confirm-pin" placeholder="Confirm PIN" maxlength="4" inputmode="numeric">
                        <button id="change-pin-btn" class="btn-secondary">Update PIN</button>
                    </div>
                    <p id="pin-change-status" class="status-message"></p>
                </div>
                <div class="setting-group">
                    <label class="toggle-label">
                        <span>Auto-lock after inactivity</span>
                        <input type="checkbox" id="auto-lock-toggle" checked>
                        <span class="toggle-slider"></span>
                    </label>
                    <p class="setting-hint">Lock after 2 minutes of no activity</p>
                </div>
            </div>
        </div>
    </div>

    <script src="app.js"></script>
</body>
</html>
